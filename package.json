  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "courseware-web": "./bin/courseware-web.mjs"
